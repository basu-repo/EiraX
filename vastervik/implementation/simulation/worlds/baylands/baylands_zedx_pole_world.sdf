<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="baylands_zedx_pole">
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors"/>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <physics name="default" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <intensity>3</intensity>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <include>
      <uri>model://baylands</uri>
      <name>baylands</name>
    </include>

    <model name="zedx_pole">
      <static>true</static>
      <pose>0 0 1.5 0 0 0</pose>

      <link name="pole_link">
        <collision name="pole_collision">
          <pose>0 0 -0.75 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.04</radius>
              <length>1.5</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="pole_visual">
          <pose>0 0 -0.75 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.04</radius>
              <length>1.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.18 0.18 0.18 1</ambient>
            <diffuse>0.24 0.24 0.24 1</diffuse>
          </material>
        </visual>

        <visual name="camera_body_visual">
          <pose>0.06 0 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.034 0.140 0.037</size>
            </box>
          </geometry>
          <material>
            <ambient>0.02 0.02 0.025 1</ambient>
            <diffuse>0.035 0.035 0.04 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <visual name="camera_front_face_visual">
          <pose>0.077 0 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.002 0.138 0.025</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.12 0.13 1</ambient>
            <diffuse>0.18 0.18 0.19 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <visual name="left_lens_visual">
          <pose>0.079 0.052 0.02 0 1.570796 0</pose>
          <geometry>
            <cylinder>
              <radius>0.016</radius>
              <length>0.006</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0.005 0.005 0.008 1</diffuse>
            <specular>0.9 0.9 0.95 1</specular>
          </material>
        </visual>
        <visual name="left_lens_inner_visual">
          <pose>0.080 0.052 0.02 0 1.570796 0</pose>
          <geometry>
            <cylinder>
              <radius>0.008</radius>
              <length>0.003</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
            <specular>1 1 1 1</specular>
          </material>
        </visual>
        <visual name="right_lens_visual">
          <pose>0.079 -0.052 0.02 0 1.570796 0</pose>
          <geometry>
            <cylinder>
              <radius>0.016</radius>
              <length>0.006</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0.005 0.005 0.008 1</diffuse>
            <specular>0.9 0.9 0.95 1</specular>
          </material>
        </visual>
        <visual name="right_lens_inner_visual">
          <pose>0.080 -0.052 0.02 0 1.570796 0</pose>
          <geometry>
            <cylinder>
              <radius>0.008</radius>
              <length>0.003</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
            <specular>1 1 1 1</specular>
          </material>
        </visual>
        <visual name="zed_logo_visual">
          <pose>0.079 0 0.0205 0 0 0</pose>
          <geometry>
            <box>
              <size>0.001 0.020 0.006</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <emissive>0.35 0.35 0.35 1</emissive>
          </material>
        </visual>

        <sensor name="zedx_rgbd" type="rgbd_camera">
          <pose>0.083 0 0.02 0 0 0</pose>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>1</visualize>
          <camera name="zedx_rgbd">
            <horizontal_fov>1.919862</horizontal_fov>
            <image>
              <width>960</width>
              <height>600</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.03</near>
              <far>40</far>
            </clip>
            <depth_camera>
              <clip>
                <near>0.3</near>
                <far>20.0</far>
              </clip>
            </depth_camera>
            <noise>
              <type>gaussian</type>
              <mean>0</mean>
              <stddev>0.005</stddev>
            </noise>
          </camera>
        </sensor>

        <sensor name="zedx_imu" type="imu">
          <topic>/model/zedx_pole/imu</topic>
          <always_on>1</always_on>
          <update_rate>200</update_rate>
          <imu>
            <enable_orientation>0</enable_orientation>
          </imu>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
