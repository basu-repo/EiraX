# Large compiled runtime assets require Git LFS.
*.so filter=lfs diff=lfs merge=lfs -text

/UGV_UAV/px4_runtime/bin/px4 filter=lfs diff=lfs merge=lfs -text

# Preserve scripts and configuration files with Unix line endings.
*.py text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.tex text eol=lf
